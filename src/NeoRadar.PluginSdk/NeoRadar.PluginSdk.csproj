<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NeoRadar</RootNamespace>
    <!-- NeoRadar.exe is AOT and links this assembly; plugins bind to the JIT copy the host ships. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>NeoRadar.PluginSdk</PackageId>
    <!-- Equals PluginSdkVersion.Current; PluginSdkVersionTests pins it. -->
    <Version>0.4.0</Version>
    <Authors>NeoRadar</Authors>
    <Description>Public SDK for NeoRadar plugins: the BasePlugin entry point, ICoreApi and the event and model types.</Description>
    <RepositoryUrl>https://github.com/neoradar-project/plugin-sdk</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1573: a <param> tag is written only where it adds a unit, range or sentinel. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
